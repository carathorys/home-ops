          "expr": "max(kubelet_volume_stats_used_bytes{namespace=~\"$namespace\"} / kubelet_volume_stats_capacity_bytes{namespace=~\"$namespace\"})",
          "legendFormat": "",
          "refId": "A",
          "instant": true,
          "range": false
