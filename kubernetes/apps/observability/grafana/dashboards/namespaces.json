    {
      "id": 16,
      "type": "bargauge",
      "title": "Volume usage",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "PVC usage from kubelet volume stats (NFS-backed volumes may not report).",
      "gridPos": {
