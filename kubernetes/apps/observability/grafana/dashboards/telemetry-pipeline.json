      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": true,
            "axisSoftMin": 0,
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          }
        },
        "overrides": []
      }
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Failures by exporter",
      "description": "Empty or flat at zero is good.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 6
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (exporter) (rate({__name__=~\"otelcol_exporter_send_failed_.+\"}[$__rate_interval]))",
          "legendFormat": "{{exporter}} send failed",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (exporter) (rate({__name__=~\"otelcol_exporter_enqueue_failed_.+\"}[$__rate_interval]))",
          "legendFormat": "{{exporter}} queue full",
          "refId": "B"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (receiver) (rate({__name__=~\"otelcol_receiver_refused_log_records(_total)?\"}[$__rate_interval]) or rate({__name__=~\"otelcol_receiver_refused_spans(_total)?\"}[$__rate_interval]) or rate({__name__=~\"otelcol_receiver_refused_metric_points(_total)?\"}[$__rate_interval]))",
          "legendFormat": "{{receiver}} refused",
          "refId": "C"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": ["mean", "max"],
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": true,
            "axisSoftMin": 0,
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          }
        },
        "overrides": []
      }
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Exporter queue size",
      "description": "Batches waiting to be sent; a growing queue means the backend is slow or down.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 14
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "max by (job, exporter) (otelcol_exporter_queue_size)",
          "legendFormat": "{{job}} {{exporter}}",
          "refId": "A"
