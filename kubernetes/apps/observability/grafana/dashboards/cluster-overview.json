      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "instance:node_load1_per_cpu:ratio{job=\"node-exporter\"}",
          "legendFormat": "{{nodename}}",
          "refId": "A"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
