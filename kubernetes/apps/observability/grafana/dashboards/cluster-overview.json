      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "instance:node_memory_utilisation:ratio{job=\"node-exporter\"}",
          "legendFormat": "{{nodename}}",
