{
  "uid": "gpu",
  "title": "gpu",
  "description": "GPU units (generic-device-plugin), GPU pods per node, GPU usage, and the scheduler's events.",
  "tags": ["kubernetes", "gpu", "managed-by-gitops"],
  "editable": true,
  "graphTooltip": 1,
  "refresh": "1m",
  "schemaVersion": 41,
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "timezone": "browser",
  "links": [
    {
      "title": "k8s dashboard",
      "type": "link",
      "url": "/d/cluster-overview",
      "icon": "dashboard",
      "keepTime": true,
      "includeVars": false,
      "targetBlank": false,
      "tooltip": "",
      "tags": [],
      "asDropdown": false
    }
  ],
  "templating": {
    "list": [
      {
        "name": "datasource",
        "label": "Metrics",
        "type": "datasource",
        "query": "prometheus",
        "current": {
          "text": "prometheus",
          "value": "prometheus"
        },
        "hide": 0,
        "refresh": 1,
        "regex": "",
        "options": []
      },
      {
        "name": "loki",
        "label": "Logs",
        "type": "datasource",
        "query": "loki",
        "current": {
          "text": "loki",
          "value": "loki"
        },
        "hide": 0,
        "refresh": 1,
        "regex": "",
        "options": []
      },
      {
        "name": "object",
        "label": "Pod filter (regex)",
        "type": "textbox",
        "query": ".+",
        "hide": 0,
        "current": {
          "text": ".+",
          "value": ".+"
        },
        "options": [],
        "description": "Limit the events to pods matching this regex, e.g. ollama.* or immich-machine-learning.*"
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "GPU units (devic.es/dri, 10 per GPU node)",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "id": 2,
      "type": "bargauge",
      "title": "Units reserved per node",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "devic.es/dri units requested by pods on the node, out of what the node offers. A pod only fits where enough units are free: this is why GPU pods land where they do.",
      "gridPos": {
        "h": 7,
        "w": 8,
        "x": 0,
        "y": 1
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (node) (kube_pod_container_resource_requests{resource=\"devic_es_dri\"} * on (namespace, pod) group_left () (max by (namespace, pod) (kube_pod_status_phase{phase=~\"Running|Pending\"}) == 1)) or (sum by (node) (kube_node_status_allocatable{resource=\"devic_es_dri\"}) * 0)",
          "legendFormat": "{{node}}",
          "refId": "A",
          "instant": true,
          "range": false
        }
      ],
      "options": {
        "displayMode": "gradient",
        "orientation": "horizontal",
        "showUnfilled": true,
        "valueMode": "color",
        "namePlacement": "left",
        "sizing": "auto",
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "min": 0,
          "max": 10,
          "decimals": 0,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 8
              },
              {
                "color": "red",
                "value": 10
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Units reserved per node over time",
      "description": "Steps show pods arriving on or leaving a node; compare with the scheduling events below.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 7,
        "w": 16,
        "x": 8,
        "y": 1
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (node) (kube_pod_container_resource_requests{resource=\"devic_es_dri\"} * on (namespace, pod) group_left () (max by (namespace, pod) (kube_pod_status_phase{phase=~\"Running|Pending\"}) == 1))",
          "legendFormat": "{{node}}",
          "refId": "A"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": ["lastNotNull", "max"],
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": true,
            "axisSoftMin": 0,
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          },
          "min": 0,
          "max": 10
        },
        "overrides": []
      }
    },
    {
      "id": 4,
      "type": "table",
      "title": "GPU pods (click a pod name to see its scheduling events)",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "Every pod holding GPU units: where it runs, how many render-node (dri) and KFD (ROCm) units.",
      "gridPos": {
        "h": 9,
        "w": 24,
        "x": 0,
        "y": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (node, namespace, pod) (kube_pod_container_resource_requests{resource=\"devic_es_dri\"} * on (namespace, pod) group_left () (max by (namespace, pod) (kube_pod_status_phase{phase=~\"Running|Pending\"}) == 1))",
          "legendFormat": "",
          "refId": "A",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (node, namespace, pod) (kube_pod_container_resource_requests{resource=\"devic_es_kfd\"} * on (namespace, pod) group_left () (max by (namespace, pod) (kube_pod_status_phase{phase=~\"Running|Pending\"}) == 1))",
          "legendFormat": "",
          "refId": "B",
          "instant": true,
          "range": false,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "renameByName": {
              "node": "Node",
              "namespace": "Namespace",
              "pod": "Pod",
              "Value #A": "dri units",
              "Value #B": "kfd (ROCm)"
            },
            "indexByName": {
              "node": 0,
              "Value #A": 1,
              "Value #B": 2,
              "namespace": 3,
              "pod": 4
            }
          }
        },
        {
          "id": "sortBy",
          "options": {
            "sort": [
              {
                "field": "Node"
              },
              {
                "field": "dri units",
                "desc": true
              }
            ]
          }
        }
      ],
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        }
      },
      "fieldConfig": {
        "defaults": {
          "noValue": "",
          "custom": {
            "align": "auto"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "dri units"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "gauge",
                  "mode": "basic"
                }
              },
              {
                "id": "min",
                "value": 0
              },
              {
                "id": "max",
                "value": 10
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Pod"
            },
            "properties": [
              {
                "id": "links",
                "value": [
                  {
                    "title": "Scheduling events of this pod",
                    "url": "/d/gpu?${__url_time_range}&var-object=${__value.raw}"
                  }
                ]
              }
            ]
          }
        ]
      }
    },
    {
      "id": 5,
      "type": "row",
      "title": "GPU usage",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 17
      },
      "panels": []
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "GPU busy",
      "description": "Actual iGPU load (amdgpu). Units are only reservations; this is what the GPU really does.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 18
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "max by (nodename) (node_drm_gpu_busy_percent) / 100",
          "legendFormat": "{{nodename}}",
          "refId": "A"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": ["lastNotNull", "max"],
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": true,
            "axisSoftMin": 0,
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          },
          "min": 0,
          "max": 1
        },
        "overrides": []
      }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "GPU memory used (VRAM + GTT)",
      "description": "Models loaded by Ollama / Immich ML show up here (mostly GTT, i.e. system RAM used by the GPU).",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 18
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (nodename) (node_drm_memory_vram_used_bytes + node_drm_memory_gtt_used_bytes)",
          "legendFormat": "{{nodename}}",
          "refId": "A"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": ["lastNotNull", "max"],
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": true,
            "axisSoftMin": 0,
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          }
        },
        "overrides": []
      }
    },
    {
      "id": 8,
      "type": "row",
      "title": "Scheduling (Kubernetes events)",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 26
      },
      "panels": []
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Failed scheduling attempts",
      "description": "Pods the scheduler could not place, e.g. '0/3 nodes are available: Insufficient devic.es/dri'.",
      "datasource": {
        "type": "loki",
        "uid": "${loki}"
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 27
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "${loki}"
          },
          "expr": "sum by (k8s_object_name) (count_over_time({service_name=\"k8s-events\"} | k8s_event_reason=\"FailedScheduling\" | k8s_object_name=~\"$object\" [$__auto]))",
          "legendFormat": "{{k8s_object_name}}",
          "refId": "A",
          "queryType": "range"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": ["lastNotNull", "max"],
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "bars",
            "lineWidth": 1,
            "fillOpacity": 60,
            "showPoints": "never",
            "spanNulls": true,
            "axisSoftMin": 0,
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          }
        },
        "overrides": []
      }
    },
    {
      "id": 10,
      "type": "logs",
      "title": "Scheduling decisions (where and why)",
      "datasource": {
        "type": "loki",
        "uid": "${loki}"
      },
      "description": "Scheduled = 'Successfully assigned <pod> to <node>'. FailedScheduling explains which nodes were rejected and why (insufficient units, node affinity, ...). Kept 14 days in Loki.",
      "gridPos": {
        "h": 12,
        "w": 24,
        "x": 0,
        "y": 35
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "${loki}"
          },
          "refId": "A",
          "queryType": "range",
          "expr": "{service_name=\"k8s-events\"} | k8s_event_reason=~\"Scheduled|FailedScheduling|Preempted|Preempting|NotTriggerScaleUp\" | k8s_object_name=~\"$object\""
        }
      ],
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending",
        "enableLogDetails": true,
        "dedupStrategy": "none",
        "showCommonLabels": false,
        "showLabels": false,
        "prettifyLogMessage": false
      }
    },
    {
      "id": 11,
      "type": "logs",
      "title": "Other warnings for these objects (OOM, probes, pulls, evictions)",
      "datasource": {
        "type": "loki",
        "uid": "${loki}"
      },
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 47
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "${loki}"
          },
          "refId": "A",
          "queryType": "range",
          "expr": "{service_name=\"k8s-events\"} | detected_level=\"warn\" | k8s_event_reason!=\"FailedScheduling\" | k8s_object_name=~\"$object\""
        }
      ],
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending",
        "enableLogDetails": true,
        "dedupStrategy": "none",
        "showCommonLabels": false,
        "showLabels": false,
        "prettifyLogMessage": false
      }
    }
  ]
}
